NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/db_name?schema=public"
JWT_SECRET=JWT_SECRET_KEY
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Email Configuration
# For Development (Mailtrap Fake SMTP Server)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=mailtrap-username
MAIL_PASSWORD=mailtrap-password
MAIL_FROM=noreply@vendome.digital
SUPPORT_EMAIL=support@vendome.digital

# For Production (Real SMTP Server like Gmail, SendGrid, etc.)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=email@gmail.com
# MAIL_PASSWORD=app-password
# MAIL_FROM=email@gmail.com
# SUPPORT_EMAIL=vendome.support@yopmail.com
